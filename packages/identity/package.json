{
  "name": "@mfi/identity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Password hashing, session token handling, and the permission model",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mfi/contracts": "workspace:*",
    "@node-rs/argon2": "^2.0.2"
  }
}
