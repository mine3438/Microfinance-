{
  "name": "@mfi/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Postgres access with tenant-scoped transactions and driver-safety guarantees",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "pretest": "pnpm --filter \"@mfi/db^...\" build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@mfi/money": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@mfi/domain": "workspace:*",
    "@mfi/identity": "workspace:*",
    "@mfi/migrator": "workspace:*",
    "@types/pg": "^8.11.10"
  }
}
