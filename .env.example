# Copy to .env and fill in. Never commit .env — see .gitignore.
# A leaked credential here reaches the institution's entire loan book.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mfi:mfi_local_dev@localhost:5432/mfi_manager

# ── Cache / rate limiting ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ── API ─────────────────────────────────────────────────────────────────────
# Signs access tokens. At least 32 characters, and the server refuses to start
# with a shorter one: HS256 is HMAC-SHA-256, so a weak key is brute-forceable
# offline by anyone holding a single issued token, and a forged token is any
# user in any institution. Generate with `openssl rand -base64 48`.
JWT_SECRET=

# Origins permitted to call this API from a browser. Comma-separated. No
# wildcard: `*` cannot be combined with credentials, and the refresh cookie
# needs them.
CORS_ORIGINS=http://localhost:5173

# Optional. Shown here with their defaults, which are the intended values —
# fifteen minutes of access, thirty days of session, the long one made safe by
# rotation rather than by being short.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000

# Adds Secure to the refresh cookie. On by default and refused off in
# production; turn it off only for local HTTP development.
# COOKIE_SECURE=true

# How an invitation reaches the person invited. No supplied document names an
# email provider, so none is integrated and none is required.
#
#   manual  the API returns the invitation link, once, to the administrator who
#           created it, and they convey it. Needs no secrets and no vendor.
#   log     the link goes to the server log instead. Development only — refused
#           in production, where a live single-use token in a log store is a
#           credential disclosed to everyone with access to telemetry.
#
# Adding SMTP or a transactional provider later is one class against the
# InvitationDelivery interface, not a change to this file's meaning.
# INVITATION_DELIVERY=manual

# Absolute URL of the web app, used to build the acceptance link. Defaults to
# the first entry in CORS_ORIGINS. Set it when the web app is not served there,
# so invitees are not sent to a host that 404s.
# WEB_BASE_URL=http://localhost:5173
