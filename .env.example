# Copy to .env and fill in. Never commit .env — see .gitignore.
# A leaked credential here reaches the institution's entire loan book.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mfi:mfi_local_dev@localhost:5432/mfi_manager

# ── Cache / rate limiting ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
